<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:focusableInTouchMode="true">
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical" android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="20sp"
                android:text="@string/settings"
                android:paddingBottom="10dp"/>

            <Spinner
                android:id="@+id/api_spinner"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:paddingBottom="23dp">
                <EditText
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:hint="@string/enter_api_key"
                    android:inputType="textPassword"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:id="@+id/apiKey"/>

                <Button
                    android:id="@+id/from_file"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="@string/from_file">
                </Button>
            </LinearLayout>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_model"
                android:textStyle="bold"
                android:textSize="16sp"/>
            <Spinner
                android:id="@+id/chat_spinner"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/thinking_model"
                android:textStyle="bold"
                android:textSize="16sp"/>
            <Spinner
                android:id="@+id/think_spinner"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/gemini_image_settings"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/gemini_image_settings_desc"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/gemini_image_api_key"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="@string/gemini_image_key_hint"
                android:inputType="textPassword"
                android:singleLine="true" />

            <EditText
                android:id="@+id/gemini_image_model"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="@string/gemini_image_model_hint"
                android:singleLine="true"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/fetch_gemini_image_models"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fetch_gemini_image_models"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_delay"
                android:textSize="16sp"/>
            <EditText
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:inputType="number"
                android:id="@+id/update_delay"
                android:hint="100–1000"/>

            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shrink_thinking"
                android:id="@+id/shrinkThinking"/>
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/shrink_thinking_desc"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/web_search"
                android:id="@+id/webSearch"/>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_engine"
                    android:textStyle="bold"/>
                <Spinner
                    android:id="@+id/search_engine_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:entries="@array/search_engines"/>
            </LinearLayout>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_engine_"
                android:layout_marginBottom="12dp"/>

            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/web_fetch"
                android:id="@+id/webFetch"/>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/web_fetch_"
                android:layout_marginBottom="12dp"/>

            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/disable_tools_img"
                android:id="@+id/disableToolsImg"/>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/disable_tools_img_"
                android:layout_marginBottom="12dp"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_system"
                android:id="@+id/changeSystemPrompt"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"/>
        <Button
            android:id="@+id/ok"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@android:string/ok" />
    </LinearLayout>
</LinearLayout>
