<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 1. Thinking layout -->
    <LinearLayout
        android:id="@+id/thinkingLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/thinking_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/thinking"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/noThinking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/thinkingProcess"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            tools:ignore="SmallSp" />
    </LinearLayout>

    <!-- 2. Horizontal container for response text (emitted before or without search) -->
    <LinearLayout
        android:id="@+id/response"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Blue accent line -->
        <View
            android:id="@+id/accent"
            android:layout_width="2dp"
            android:layout_height="fill_parent"
            android:layout_marginRight="8dp"
            android:background="#2B88D9" />

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/llm"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@android:color/primary_text_dark_nodisable"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/message_text"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@android:color/primary_text_dark_nodisable"
                android:textSize="14sp" />

            <io.github.gohoski.numai.ui.MathMarkdownView
                android:id="@+id/message_math"
                android:layout_width="fill_parent"
                android:layout_height="1dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/generated_image"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:maxHeight="420dp"
                android:contentDescription="@string/gemini_generated_image"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Search layout (placed after the preliminary response) -->
    <LinearLayout
        android:id="@+id/searchLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/thinking_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/searchTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@android:string/search_go"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/searchResultsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                tools:text="12 results" />
        </LinearLayout>

        <TextView
            android:id="@+id/searchQueries"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 4. Reading sources layout (shown when the model uses web_fetch) -->
    <LinearLayout
        android:id="@+id/readingLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/thinking_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/readingTitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/reading_sources"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/readingUrls"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
